<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/im_playlist_image"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"

        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Best songs"
        style="@style/baseDayAndNightTextStyle"
        android:textSize="16sp"

        app:layout_constraintEnd_toEndOf="@+id/im_playlist_image"
        app:layout_constraintStart_toStartOf="@+id/im_playlist_image"
        app:layout_constraintTop_toBottomOf="@+id/im_playlist_image" />

    <TextView
        android:id="@+id/tv_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="98 треков"
        style="@style/baseDayAndNightTextStyle"

        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/im_playlist_image"
        app:layout_constraintStart_toStartOf="@+id/im_playlist_image"
        app:layout_constraintTop_toBottomOf="@+id/tv_name" />

</androidx.constraintlayout.widget.ConstraintLayout>