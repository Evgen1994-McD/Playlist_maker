<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.media.fragments.AddPlayListFragment">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Search_Toolbar_style"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:title="Новый плейлист"
        app:layout_constraintBottom_toTopOf="@id/im_mine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:navigationIcon="@drawable/ic_backblack_16">

    </androidx.appcompat.widget.Toolbar>


    <ImageView
        android:id="@+id/im_mine"
        android:layout_width="312dp"
        android:layout_height="312dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="32dp"
        android:scaleType="centerCrop"

        android:background="@drawable/shape_add_playlist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <ImageView
        android:id="@+id/ph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_ph_newplaylist_80"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/im_mine"
        app:layout_constraintEnd_toEndOf="@+id/im_mine"
        app:layout_constraintStart_toStartOf="@+id/im_mine"
        app:layout_constraintTop_toTopOf="@+id/im_mine" />

    <EditText
        android:id="@+id/ed_playlist_name"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shape_edit_text_line"
        android:ems="10"
        android:hint="Название*"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/im_mine" />

    <EditText
        android:id="@+id/ed_about_playlist"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shape_edit_text_line"
        android:ems="10"
        android:hint="Описание"
        android:inputType="text"

        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ed_playlist_name" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bt_add_playlist"
        android:enabled="false"
        android:text="Создать"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>